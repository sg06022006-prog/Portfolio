---
import type { Project } from '../data/projects';
import { translator } from '../i18n/ui';
import { asset, pagePath, type Locale } from '../i18n/paths';

interface Props {
  projects: Project[];
  title: string;
  introduction: string;
  sectionTitle: string;
  countLabel: string;
  breadcrumb: string;
  locale?: Locale;
}

const { projects, title, introduction, sectionTitle, countLabel, breadcrumb, locale = 'en' } = Astro.props;
const t = translator(locale);
---

  <main class="projects-page">
    <div class="page-top">
      <span>{breadcrumb}</span>
      <span>{t('allWorks')} / {new Date().getFullYear()}</span>
    </div>

    <section class="introduction">
      <p class="eyebrow">01 / {t('portfolio')}</p>
      <h1>{title}<span>.</span></h1>
      <p>
        {introduction}
      </p>
    </section>

    <section class="gallery" aria-label={sectionTitle}>
      <div class="gallery-heading">
        <h2>{sectionTitle}</h2>
        <span>{projects.length} {countLabel}</span>
      </div>

      <div class="projects-grid">
        {projects.map((project) => (
          <a
            href={pagePath(locale, `projects/${project.slug}/`)}
            class="project-card"
            aria-label={`${t('view')}: ${project.title}`}
          >
            <div class="image-container">
              <img
                src={asset(project.thumbnail)}
                srcset={`${asset(project.thumbnail)} 800w, ${asset(project.preview)} 1600w`}
                sizes="(max-width: 700px) 100vw, 50vw"
                alt={project.alt}
                loading="lazy"
                decoding="async"
              />
              <span class="view-label">{t('view')} ↗</span>
            </div>

            <div class="project-info">
              <div>
                <p>{project.category}</p>
                <h3>{project.title}</h3>
                {project.status === 'in-progress' && <span class="work-status">{t('inProgress')}</span>}
                <span class="availability">{project.model ? t('available3d') : t('previewOnly')}</span>
              </div>
              <span class="arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

<style>
  .projects-page {
    min-height: 100vh;
    padding: 42px 6% 100px;
    background: #0b100d;
    color: #f3f5f2;
  }

  .page-top {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #829586;
    font-size: 10px;
    letter-spacing: 2px;
  }

  .introduction {
    padding: 90px 0 100px;
    border-bottom: 1px solid #29372d;
  }

  .eyebrow {
    color: #9ddd64;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
  }

  h1 {
    margin: 25px 0;
    font-size: clamp(45px, 6vw, 95px);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  h1 span {
    color: #9ddd64;
  }

  .introduction > p:last-child {
    max-width: 600px;
    color: #9bac9e;
    font-size: 16px;
    line-height: 1.8;
  }

  .gallery {
    padding-top: 55px;
  }

  .gallery-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 30px;
  }

  .gallery-heading h2 {
    margin: 0;
    font-size: 24px;
  }

  .gallery-heading span {
    color: #9bac9e;
    font-size: 11px;
    letter-spacing: 2px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .project-card {
    overflow: hidden;
    background: #171f19;
    border: 1px solid #2d3a30;
    border-radius: 14px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.3s, transform 0.3s;
  }

  .project-card:hover {
    border-color: #9ddd64;
    transform: translateY(-4px);
  }

  .image-container {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #253026;
  }

  .image-container img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .project-card:hover img {
    transform: scale(1.05);
  }

  .view-label {
    position: absolute;
    right: 18px;
    bottom: 18px;
    padding: 9px 12px;
    background: #9ddd64;
    border-radius: 6px;
    color: #0b100d;
    font-size: 10px;
    font-weight: bold;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .project-card:hover .view-label {
    opacity: 1;
  }

  .project-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px;
  }

  .project-info p {
    margin: 0 0 8px;
    color: #9ddd64;
    font-size: 10px;
    letter-spacing: 1.5px;
  }

  .project-info h3 {
    margin: 0;
    font-size: 23px;
  }

  .arrow {
    color: #9ddd64;
    font-size: 26px;
  }
  .availability { display: block; margin-top: 10px; color: #a1b1a4; font-size: 12px; }
  .project-card:focus-visible .view-label { opacity: 1; }
  .project-card { min-width: 0; }
  @media (hover: none) { .view-label { opacity: 1; } }

  @media (max-width: 768px) {
    .projects-page {
      padding: 30px 5% 70px;
    }

    .introduction {
      padding: 70px 0;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .image-container img,
    .view-label {
      transition: none;
    }

    .project-card:hover,
    .project-card:hover img {
      transform: none;
    }
  }
</style>
