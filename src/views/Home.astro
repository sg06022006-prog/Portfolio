
---
import Layout from '../layouts/Layout.astro';
import { getProjects } from '../data/projects';
import { translator } from '../i18n/ui';
import { asset, pagePath, type Locale } from '../i18n/paths';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const t = translator(locale);

const projects = (await getProjects(locale)).filter((project) => project.featured);

const experience = [
  {
    number: '01',
    label: t('currentFocus'),
    title: t('art'),
    description: t('focus'),
  },
  {
    number: '02',
    label: t('background'),
    title: t('gameDev'),
    description: t('previousGames'),
  },
  {
    number: '03',
    label: t('creativeExperience'),
    title: t('otherSkills'),
    description: t('otherCreative'),
  },
];

---

<Layout locale={locale} title={'Dblmok | ' + t('portfolio')} description={t('homeIntro')}>
  <main class="page" id="top">
    <section class="hero" aria-labelledby="hero-title">

      <div class="hero-topline">
        <span>{t('introduction')}</span>
        <span>{new Date().getFullYear()} / {t('art')}</span>
      </div>

      <div class="hero-content">
        <p class="eyebrow">
          <span class="status-dot"></span>
          {t('focus')}
        </p>

        <h1 id="hero-title">
          {t('hello')}<br />
          <span class="hero-name">Dblmok<span class="accent">.</span></span>
        </h1>

        <div class="hero-description">
          <p class="intro">
            {t('specialization')}
          </p>

          <p class="about-text">
            {t('homeIntro')}
          </p>

          <p class="about-text">
            {t('homeGoal')}
          </p>
        </div>

        <a class="explore-button" href="#projects">
          <span>{t('explore')}</span>
          <span class="button-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="experience-section">
        <div class="section-meta">
          <span>{t('skills')}</span>
          <span>01 / 03</span>
        </div>

        <div class="experience-grid">
          {experience.map((item) => (
            <article class="experience-card">
              <div class="experience-top">
                <span>{item.number} / {item.label}</span>
                <span aria-hidden="true">↗</span>
              </div>

              <div class="experience-bottom">
                <h2>{item.title}</h2>
                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

    </section>
    <section
      class="projects"
      id="projects"
      aria-labelledby="projects-title"
    >

      <div class="projects-heading">
        <div>
          <p class="eyebrow">02 / {t('portfolio')}</p>
          <h2 id="projects-title">
            {t('selected')}<span class="accent">.</span>
          </h2>
        </div>

        <span class="project-count">
          {String(projects.length).padStart(2, '0')} {t('projectCount')}
        </span>
      </div>

      <div class="projects-grid">
        {projects.map((project) => (
          <a
            class="project-card"
            href={pagePath(locale, `projects/${project.slug}/`)}
            aria-label={`${t('view')}: ${project.title}`}
          >
            <div class="project-image">
              <img
                src={asset(project.thumbnail)}
                srcset={`${asset(project.thumbnail)} 800w, ${asset(project.preview)} 1600w`}
                sizes="(max-width: 700px) 100vw, 50vw"
                alt={project.alt}
                loading="lazy"
                decoding="async"
              />

              <div class="image-overlay">
                <span>{t('view')}</span>
              </div>
            </div>

            <div class="project-info">
              <div class="project-details">
                <p class="project-category">
                  {project.category}
                </p>

                <h3>{project.title}</h3>
                {project.status === 'in-progress' && <span class="work-status">{t('inProgress')}</span>}
              </div>

              <div class="project-right">
                <span class="project-number">
                  {project.number}
                </span>

                <span class="project-arrow" aria-hidden="true">
                  ↗
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </section>

  </main>
</Layout>

<style>
  .page {
    min-height: 100vh;
    background: #0b100d;
    color: #f3f5f2;
  }

  /* HERO */

  .hero {
    min-height: 100vh;
    min-height: 100svh;
    padding: 42px 6% 44px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 60px;
    background:
      radial-gradient(
        ellipse at 95% 18%,
        rgba(157, 221, 100, 0.065),
        transparent 48%
      ),
      #0b100d;
  }

  .hero-topline,
  .section-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #748879;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.8px;
  }

  .hero-content {
    width: 100%;
    max-width: 1150px;
    margin: auto 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 28px;
    color: #9ddd64;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    background: #9ddd64;
    border-radius: 50%;
    box-shadow: 0 0 15px #9ddd6470;
  }

  h1 {
    margin: 0 0 38px;
    font-size: clamp(58px, 8vw, 148px);
    line-height: 0.93;
    font-weight: 900;
    letter-spacing: -0.075em;
  }

  .hero-name {
    color: #f3f5f2;
  }

  .accent {
    color: #9ddd64;
  }

  .hero-description {
    max-width: 680px;
  }

  .intro {
    margin: 0 0 18px;
    color: #e3ede3;
    font-size: clamp(19px, 2vw, 25px);
    font-weight: 500;
    line-height: 1.5;
  }

  .about-text {
    max-width: 640px;
    margin: 0 0 12px;
    color: #9bac9e;
    font-size: 15px;
    line-height: 1.85;
  }

  .explore-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 55px;
    margin-top: 28px;
    padding: 17px 20px 17px 25px;
    background: #9ddd64;
    color: #101710;
    border-radius: 14px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-decoration: none;
    transition:
      background 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .explore-button:hover {
    background: #baf38e;
    transform: translateY(-3px);
    box-shadow: 0 12px 35px #9ddd6425;
  }

  .button-arrow {
    font-size: 22px;
    font-weight: 400;
  }

  /* EXPERIENCE */

  .experience-section {
    width: 100%;
  }

  .section-meta {
    padding-bottom: 16px;
  }

  .experience-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .experience-card {
    min-height: 154px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 25px;
    padding: 20px 22px;
    background: #19231c;
    border: 1px solid #2b3930;
    border-radius: 12px;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .experience-card:hover {
    background: #223025;
    border-color: #9ddd64;
    transform: translateY(-4px);
  }

  .experience-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    color: #9ddd64;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.1px;
  }

  .experience-bottom h2 {
    margin: 0 0 9px;
    color: #f3f5f2;
    font-size: clamp(17px, 1.6vw, 23px);
    letter-spacing: -0.02em;
  }

  .experience-bottom p {
    margin: 0;
    color: #91a595;
    font-size: 12px;
    line-height: 1.6;
  }

  /* PROJECTS */

  .projects {
    padding: 95px 6% 110px;
    border-top: 1px solid #29372d;
    scroll-margin-top: 20px;
  }

  .projects-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 25px;
    margin-bottom: 42px;
  }

  .projects-heading .eyebrow {
    margin-bottom: 14px;
  }

  .projects-heading h2 {
    margin: 0;
    font-size: clamp(32px, 4vw, 58px);
    line-height: 1.1;
    letter-spacing: -0.045em;
  }

  .project-count {
    padding-bottom: 5px;
    color: #8b9d8f;
    font-size: 11px;
    letter-spacing: 2px;
    white-space: nowrap;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    max-width: 1250px;
  }

  .project-card {
    display: block;
    min-width: 0;
    overflow: hidden;
    background: #171f19;
    border: 1px solid #2d3a30;
    border-radius: 14px;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.3s,
      transform 0.3s;
  }

  .project-card:hover {
    border-color: #9ddd64;
    transform: translateY(-4px);
  }

  .project-image {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #253026;
  }

  .project-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .project-card:hover img {
    transform: scale(1.055);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: end;
    justify-content: end;
    padding: 18px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.52),
      transparent 45%
    );
    opacity: 0;
    transition: opacity 0.3s;
  }

  .image-overlay span {
    color: #f3f5f2;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .project-card:hover .image-overlay {
    opacity: 1;
  }

  .project-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px;
  }

  .project-category {
    margin: 0 0 9px;
    color: #9ddd64;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.5px;
  }

  .project-details h3 {
    margin: 0;
    color: #f3f5f2;
    font-size: 23px;
    font-weight: 700;
  }

  .project-right {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .project-number {
    color: #819184;
    font-size: 11px;
  }

  .project-arrow {
    color: #9ddd64;
    font-size: 26px;
    transition: transform 0.3s;
  }

  .project-card:hover .project-arrow {
    transform: translate(3px, -3px);
  }

  @media (max-width: 1100px) {
    .hero {
      gap: 48px;
    }

    h1 {
      font-size: clamp(56px, 7.5vw, 100px);
    }

    .experience-card {
      padding: 18px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 48px 5% 38px;
      gap: 65px;
    }

    .hero-topline {
      font-size: 9px;
    }

    h1 {
      font-size: clamp(48px, 11vw, 85px);
      letter-spacing: -0.06em;
    }

    .intro {
      font-size: 19px;
    }

    .about-text {
      font-size: 14px;
    }

    .experience-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .experience-card {
      min-height: 125px;
    }

    .projects {
      padding: 65px 5% 75px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .projects-heading {
      align-items: start;
      flex-direction: column;
      gap: 14px;
    }

    .project-info {
      padding: 18px;
    }
  }

  @media (max-width: 420px) {
    .hero-topline span:last-child {
      display: none;
    }

    .eyebrow {
      font-size: 10px;
      letter-spacing: 1.5px;
    }

    h1 {
      font-size: clamp(43px, 11vw, 58px);
    }

    .explore-button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .explore-button,
    .experience-card,
    .project-card,
    .project-image img,
    .image-overlay,
    .project-arrow {
      transition: none;
    }

    .explore-button:hover,
    .experience-card:hover,
    .project-card:hover,
    .project-card:hover img,
    .project-card:hover .project-arrow {
      transform: none;
    }
  }
</style>
