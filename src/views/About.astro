---
import Layout from '../layouts/Layout.astro';
import { contacts } from '../data/contacts';
import { translator } from '../i18n/ui';
import { pagePath, type Locale } from '../i18n/paths';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const t = translator(locale);
---
<Layout locale={locale} title={t('about') + ' | Dblmok'} description={t('aboutIntro')}>
  <main class="about-page">
    <p class="eyebrow">{t('portfolio')} / {t('about')}</p>
    <header>
      <h1>{t('hello')}<br />Dblmok<span>.</span></h1>
      <p class="lead">{t('specialization')}</p>
      <p class="introduction">{t('aboutIntro')}</p>
    </header>
    <div class="about-grid">
      <section aria-labelledby="learning-title">
        <p class="eyebrow">01 / {t('currentFocus')}</p>
        <h2 id="learning-title">{t('learningTitle')}</h2>
        <p>{t('learningBody')}</p><p>{t('practiceBody')}</p>
        <a class="text-link" href={pagePath(locale, 'projects/')}>{t('explore')} ↗</a>
      </section>
      <aside class="focus-card" aria-label={t('tools')}>
        <h2>{t('currentTool')}</h2><span class="tool">Blender</span>
        <h2>{t('nextSteps')}</h2><p>{t('nextBody')}</p>
      </aside>
      <section aria-labelledby="background-title">
        <p class="eyebrow">02 / {t('creativeExperience')}</p>
        <h2 id="background-title">{t('backgroundTitle')}</h2><p>{t('backgroundBody')}</p>
      </section>
    </div>
    <section class="contact" aria-labelledby="contact-title">
      <p class="eyebrow">03 / {t('contact')}</p>
      <h2 id="contact-title">{t('contactTitle')}<span>.</span></h2><p>{t('contactBody')}</p>
      <div class="contact-links">
        <a href={'mailto:' + contacts.email}>{contacts.email} ↗</a>
        <a href={contacts.telegramUrl}>Telegram @{contacts.telegram} ↗</a>
      </div>
    </section>
  </main>
</Layout>
<style>

  .about-page {
    padding: 42px 6% 80px;
    color: #f3f5f2;
  }

  .eyebrow { color: #9ddd64; font-size: 11px; letter-spacing: 2px; }
  header { padding: 60px 0; }
  h1 { margin: 0 0 30px; font-size: clamp(52px, 7vw, 110px); line-height: 1; letter-spacing: -0.06em; }
  h1 span, h2 span { color: #9ddd64; }
  .lead { color: #e3ede3; font-size: 23px; }
  p { color: #9bac9e; font-size: 16px; line-height: 1.85; }
  .introduction { max-width: 680px; }
  h2 { margin: 16px 0; font-size: clamp(24px, 2.5vw, 34px); line-height: 1.25; }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(240px, 1fr);
    gap: 48px;
    padding: 48px 0 64px;
    border-top: 1px solid #29372d;
  }

  .focus-card { padding: 28px; align-self: start; background: #171f19; border: 1px solid #2d3a30; border-radius: 14px; }
  .focus-card h2 { font-size: 18px; }
  .focus-card h2:not(:first-child) { margin-top: 32px; }
  .tool { display: inline-block; padding: 8px 14px; background: #253026; border-radius: 6px; }
  a { color: #9ddd64; text-decoration: none; overflow-wrap: anywhere; }
  a:hover { text-decoration: underline; }
  a:focus-visible { outline: 2px solid #9ddd64; outline-offset: 5px; }
  .contact { padding-top: 40px; border-top: 1px solid #29372d; }
  .contact-links { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 28px; }

  @media (max-width: 768px) {
    .about-page { padding: 30px 5% 60px; }
    header { padding: 40px 0; }
    .about-grid { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  }
</style>
